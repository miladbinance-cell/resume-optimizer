# AI Provider — use OpenRouter (recommended) OR OpenAI direct
# OpenRouter (recommended — one API key for all models)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# OpenAI (only needed if NOT using OpenRouter)
# OPENAI_API_KEY=sk-your-key-here

# Model — use openai/ prefix for OpenRouter, or bare name for OpenAI direct
# OpenRouter models: openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-2.0-flash
OPENAI_MODEL=openai/gpt-4o

# Stripe (card payments — https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# NowPayments (crypto payments — https://nowpayments.io)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
NOWPAYMENTS_CURRENCY=usdt

# SendGrid (email delivery — https://sendgrid.com)
SENDGRID_API_KEY=SG.your-sendgrid-key
FROM_EMAIL=hello@resumeai.com

# App
BASE_URL=http://localhost:8000
ENVIRONMENT=development